# Environment variables for the ingestion, index, evaluation, and usage scripts.
# Nothing loads this file automatically: export the values in your shell, or
# store them as GitHub Actions secrets. The Worker does not read it; its
# settings live in `wrangler.jsonc` and, locally, `.dev.vars`
# (see `.dev.vars.example`).

# Local RAG files, used by `npm run rag:build` and the retrieval evaluation.
RAG_DATA_DIR=".rag-data"
# Comma-separated formal case numbers used by `npm run rag:build`.
RAG_CASE_NUMBERS="1176"

# R2 access for ingestion, the case router, and the term index.
# `npm run eval:cross-case` reads only R2_BUCKET_NAME and uses the wrangler login.
CLOUDFLARE_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Cloudflare API access for `npm run usage:report` (optional; it falls back to
# the `wrangler login` credentials) and the legacy D1 ingestion script.
CLOUDFLARE_API_TOKEN=""

# Legacy D1 ingestion only (`scripts/cloud_ingest.py`).
CLOUDFLARE_D1_DATABASE_ID=""
# Preferred for the compact all-case index; comma-separated shard IDs.
CLOUDFLARE_D1_DATABASE_IDS=""
