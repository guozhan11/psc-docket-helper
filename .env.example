# OPENAI_API_KEY: Required for OpenAI API calls made by the PSC Assistant.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Local RAG files, used by the retrieval evaluation harness.
RAG_DATA_DIR=".rag-data"
# Comma-separated formal case numbers used by `npm run rag:build`.
RAG_CASE_NUMBERS="1176"

# Optional: route OpenAI calls through Cloudflare AI Gateway. When omitted,
# the Worker calls OpenAI directly. AI_GATEWAY_ID defaults to "default".
CLOUDFLARE_ACCOUNT_ID=""
AI_GATEWAY_ID="default"
# Only needed when the selected AI Gateway requires authentication.
CF_AIG_TOKEN=""

# Cloudflare Worker bot protection. TURNSTILE_SECRET is a secret and must be
# configured with `wrangler secret put` in production, never committed.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
TURNSTILE_EXPECTED_HOSTNAME="psc-docket-assistant.psc-docket-helper.workers.dev"

# GitHub Actions / scripts/cloud_ingest.py credentials. Store these as GitHub
# Actions secrets, not in a committed .env file.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_DATABASE_ID=""
# Preferred for the compact all-case index; comma-separated shard IDs.
CLOUDFLARE_D1_DATABASE_IDS=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
