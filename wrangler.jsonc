{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "psc-docket-assistant",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"secrets": {
		"required": ["FEEDBACK_SECRET"]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "psc-docket-search",
			"database_id": "6bd27dcd-20e2-4731-acd4-b624fc970829"
		},
		{
			"binding": "DB_1",
			"database_name": "psc-docket-search-1",
			"database_id": "0009f827-5783-4b40-a338-890d61ec15ea"
		},
		{
			"binding": "DB_2",
			"database_name": "psc-docket-search-2",
			"database_id": "53cfbe00-c267-4b1b-87c9-c9fa97d79556"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "psc-docket-assistant-documents"
		}
	],
	"ratelimits": [
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "117601",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "CHAT_GLOBAL_RATE_LIMITER",
			"namespace_id": "117602",
			"simple": {
				"limit": 300,
				"period": 60
			}
		}
	],
	"vars": {
		"OPENAI_MODEL": "gpt-4.1",
		"AI_GATEWAY_ID": "default",
		"CLOUDFLARE_ACCOUNT_ID": "ec47eefb8bdd84301fd0dba3c74578b8",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAENFt-2gr1zekdVR",
		"TURNSTILE_EXPECTED_HOSTNAME": "psc-docket-assistant.psc-docket-helper.workers.dev"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	}
}
