{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "rag:build": "tsx scripts/build-rag-index.ts",
    "rag:prepare-cloud": "tsx scripts/prepare-cloud-rag.ts",
    "rag:publish-cloud": "tsx scripts/publish-cloud-rag.ts",
    "rag:metadata-cloud": "python3 scripts/metadata_r2_ingest.py --mode auto --all-shards --shard-count 4",
    "rag:router-cloud": "python3 scripts/build_case_router.py --shard-count 16",
    "rag:ingest-shard-0-cloud": "python3 scripts/fast_r2_ingest.py --all --concurrency 4 --max-hours 5.25 --shard-index 0 --shard-count 4",
    "rag:ingest-d1-legacy": "python3 scripts/cloud_ingest.py --all --no-ocr",
    "build:client": "vite build",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "cloudflare:dev": "npm run build:client && wrangler dev",
    "cloudflare:deploy": "npm run build:client && wrangler deploy",
    "cloudflare:db:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply DB_1 --local && wrangler d1 migrations apply DB_2 --local",
    "cloudflare:db:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 migrations apply DB_1 --remote && wrangler d1 migrations apply DB_2 --remote",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit --project worker/tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.113.0"
  }
}
