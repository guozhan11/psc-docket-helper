{
  "name": "psc-docket-helper",
  "private": true,
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "npm run cloudflare:dev",
    "rag:build": "tsx scripts/build-rag-index.ts",
    "rag:prepare-cloud": "tsx scripts/prepare-cloud-rag.ts",
    "rag:publish-cloud": "tsx scripts/publish-cloud-rag.ts",
    "rag:metadata-cloud": "python3 scripts/metadata_r2_ingest.py --mode auto --all-shards --shard-count 4",
    "rag:router-cloud": "python3 scripts/build_case_router.py --shard-count 16",
    "rag:term-index-cloud": "python3 scripts/build_term_index.py --shard-count 4096",
    "rag:ingest-shard-0-cloud": "python3 scripts/fast_r2_ingest.py --all --concurrency 4 --max-hours 5.25 --shard-index 0 --shard-count 4",
    "rag:ingest-d1-legacy": "python3 scripts/cloud_ingest.py --all --no-ocr",
    "build": "vite build",
    "start": "node scripts/render-redirect.mjs",
    "cloudflare:dev": "npm run build && wrangler dev",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:db:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply DB_1 --local && wrangler d1 migrations apply DB_2 --local",
    "cloudflare:db:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 migrations apply DB_1 --remote && wrangler d1 migrations apply DB_2 --remote",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit --project worker/tsconfig.json && tsc --noEmit --project scripts/tsconfig.json",
    "test:worker": "node --test worker/index.test.ts src/services/geminiService.test.ts",
    "test:python": "python3 -m unittest discover -s scripts -p 'test_*.py' -v",
    "test": "npm run test:worker && npm run test:python",
    "eval:validate": "node scripts/validate-evaluation.ts",
    "eval:retrieval": "node scripts/evaluate-retrieval.ts",
    "eval:cross-case": "node scripts/evaluate-cross-case.ts",
    "security:audit": "npm audit --audit-level=high",
    "usage:report": "python3 scripts/usage_report.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.120.1"
  }
}
